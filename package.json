{
  "name": "dsh-cursorlike",
  "version": "0.1.0",
  "description": "CursorLike — Cursor-style coding surface for DeepSeek Harness (fork of dsh-vscode-mode): side editor, pending-files card, diff review, Tab completion and Cmd+K inline edit.",
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "vscode",
    "editor",
    "monaco",
    "monaco-editor",
    "diff",
    "diff-review",
    "code-review",
    "diff-viewer",
    "files"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leifangwen88/dsh-cursorlike.git"
  },
  "homepage": "https://github.com/leifangwen88/dsh-cursorlike",
  "bugs": {
    "url": "https://github.com/leifangwen88/dsh-cursorlike/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0-rc.1 <0.3.0-0"
  },
  "packageManager": "pnpm@11.3.0",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "assets",
    "locale",
    "src",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@vscode/ripgrep": "^1.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "schemastery": "3.18.0",
    "semver": "^7.8.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsdown",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prebuild": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\"",
    "prepare": "npm run prebuild && npm run build",
    "pack": "npm run prebuild && npm run build && npm pack",
    "vendor:monaco": "node scripts/vendor-monaco.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
